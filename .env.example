# انسخ هذا الملف إلى .env واملأ القيم. أي تكامل بلا مفاتيح يعمل في "الوضع التجريبي".
# Copy to .env and fill in. Any integration without keys runs in demo mode.

PORT=3000
# The public URL of the site (used for Stripe redirects)
APP_URL=http://localhost:3000
# Set to "production" when deployed (disables the demo upgrade button)
NODE_ENV=development
# Optional: secret used to sign login sessions. If empty, one is generated and stored in the database.
JWT_SECRET=
# Postgres connection string (set automatically on Vercel by the Neon integration).
# Leave empty locally to use the built-in embedded database in ./data/pglite
DATABASE_URL=

# ---- OpenAI (AI drafting + prioritization) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Email sending (any SMTP provider: Gmail app password, Outlook, Resend, SendGrid, Mailgun...) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The sender address, e.g. "Mudir <noreply@yourdomain.com>"
MAIL_FROM=

# ---- Stripe (subscriptions) ----
STRIPE_SECRET_KEY=
# Create a recurring Price in the Stripe dashboard and paste its id (price_...)
STRIPE_PRICE_ID=
# From `stripe listen` locally, or the webhook endpoint you add in the dashboard
STRIPE_WEBHOOK_SECRET=
# Shown on the pricing card
PRO_PRICE_LABEL=9$ شهريًا
